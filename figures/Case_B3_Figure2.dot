digraph Case_B3_Figure2 {
  rankdir=LR;
  compound=true;
  newrank=true;

  graph [
    fontname="Helvetica",
    labelloc="t",
    fontsize=18,
    label="Figure B3-2. Fixation after Info/LCD-active overlap from LCD-docked states"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fillcolor="white",
    color="black"
  ];

  edge [
    fontname="Helvetica"
  ];
  // --------------------------------------------------
  // Bottom: Fixation occurred
  // --------------------------------------------------
  subgraph cluster_bottom {
    label="Fixation occurred (Steps 38–43, 48–52, 57–61, 338–345, 348–355)";
    fontsize=16;
    color="black";

    b_S0      [label="S0"];
    b_S4      [label="S4", fillcolor="#d9d9d9"];
    b_S7      [label="S7", fillcolor="#d9d9d9"];

    // Key overlap states: Info remains visible while LCD becomes shooting-active
    b_S5      [label="S5", color="purple", fillcolor="#d9d9d9", penwidth=3.0];
    b_S6      [label="S6", color="purple", fillcolor="#d9d9d9", penwidth=3.0];

    b_backS4  [label="S4", fillcolor="#d9d9d9"];
    b_backS7  [label="S7", fillcolor="#d9d9d9"];
    b_post0   [label="S0"];

    b_S38     [label="S38", color="red", fillcolor="#ffe6e6", penwidth=3.0];
    b_S37     [label="S37", color="red", fillcolor="#ffe6e6", penwidth=3.0];

    {rank=same; b_S4; b_S7;}
    {rank=same; b_S5; b_S6;}
    {rank=same; b_backS4; b_backS7;}

    // Route 1: [i] -> [i] -> open  => S6
    b_S0 -> b_S4 [label="[i]"];
    b_S4 -> b_S7 [label="[i]"];
    b_S7 -> b_S6 [label="open", color="purple", penwidth=3.0];

    // Route 2: [i] -> open => S5 -> [i]  => S6
    b_S4 -> b_S5 [label="open", color="purple", penwidth=3.0];
    b_S5 -> b_S6 [label="[i]", color="purple", penwidth=3.0];

    // Route 3: DISP once -> open => S6
    b_S0 -> b_S7 [label="DISP once"];
    b_backS7 -> b_S6 [label="open", color="purple"];

    // Close after the overlap states
    b_S5 -> b_backS4 [label="close"];
    b_backS4 -> b_S5  [label="open", color="purple"];
    b_S6 -> b_backS7 [label="close"];
    b_backS4 -> b_backS7  [label="[i]"];

    // Power cycle after the overlap condition
    b_backS4 -> b_post0 [label="power"];
    b_backS7 -> b_post0 [label="power"];

    // Fixation becomes visible when LCD is opened again
    b_post0 -> b_S38 [label="open", color="red", fontcolor="red", penwidth=3.0];

    // Fixed open/closed pair
    b_S38 -> b_S37 [xlabel="close", color="red", fontcolor="red", penwidth=3.0];
    b_S37 -> b_S38 [label="open", color="red", fontcolor="red", penwidth=3.0];

    // Note
    b_note [
      label="Key condition:\nInfo display enters an LCD-active shooting context (S5 or S6).\nAfter this overlap, closing the LCD and power cycling can lead to fixation,\nwhich becomes apparent when the LCD is opened again.",
      shape=note,
      style="filled",
      fillcolor="#fffaf0",
      color="gray50",
      fontname="Helvetica",
      fontsize=11
    ];

    b_S38 -> b_note [style=invis];

    // Legend
    subgraph cluster_legend_bottom {
      label="Legend";
      fontsize=12;
      color="gray";

      key_info_bottom [
        label="Grey background: Info display is shown",
        shape=plaintext
      ];

      key_LCD_bottom [
        label="Purple border: LCD is in an active shooting context",
        shape=plaintext
      ];

      key_fixed_bottom [
        label="Red border/fill: Info-fixation state",
        shape=plaintext
      ];
    }
  }
  // --------------------------------------------------
  // Top: Fixation did not occur
  // --------------------------------------------------
  subgraph cluster_top {
    label="Fixation did not occur (Steps 25–37, 79–94)";
    fontsize=16;
    color="black";

    t_S0    [label="S0"];
    t_S4    [label="S4", fillcolor="#d9d9d9"];
    t_S7    [label="S7", fillcolor="#d9d9d9"];
    t_post0 [label="S0"];
    t_S22   [label="S22", color="purple", penwidth=3.0];

    {rank=same; t_S4; t_S7;}

    // i-button route
    t_S0 -> t_S4 [label="[i]"];
    t_S4 -> t_S7 [label="[i]"];

    // DISP-once route
    t_S0 -> t_S7 [label="DISP once"];

    // Half-press clears the non-DP5 Info states
    t_S4 -> t_post0 [label="Half-press"];
    t_S7 -> t_post0 [label="Half-press"];

    // Power cycle before LCD-active overlap does not cause fixation
    t_S4 -> t_post0 [label="power", color="gray40", fontcolor="gray40"];
    t_S7 -> t_post0 [label="power", color="gray40", fontcolor="gray40"];

    // Reopening after such a power cycle leads to normal LCD-active shooting state
    t_post0 -> t_S22 [label="open", color="purple", penwidth=3.0];

    // Legend
    subgraph cluster_legend_top {
      label="Legend";
      fontsize=12;
      color="gray";

      key_info_top [
        label="Grey background: Info display is shown",
        shape=plaintext
      ];

      key_LCD_top [
        label="Purple border: LCD is in an active shooting context",
        shape=plaintext
      ];
    }
  }



  // --------------------------------------------------
  // Alignment between clusters
  // --------------------------------------------------
  {rank=same; t_S0; b_S0;}
  {rank=same; t_S4; b_S4;}
  {rank=same; t_S7; b_S7;}

  t_S0 -> b_S0 [style=invis, weight=10];
}
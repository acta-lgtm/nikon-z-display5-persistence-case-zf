digraph TimeSeriesStyled {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Helvetica"];

  // Time labels (plaintext)
  t0 [label="Power on", shape=plaintext];
  t1 [label="Open LCD", shape=plaintext];
  t2 [label="Close LCD", shape=plaintext];
  t3 [label="Press [i] button", shape=plaintext];
  t4 [label="Open LCD", shape=plaintext];
  t5 [label="Half-press", shape=plaintext];
  t6 [label="Close LCD", shape=plaintext];
  t7 [label="Power off → on", shape=plaintext];
  t8 [label="Open LCD", shape=plaintext];

  // Real Info row
  real0 [label="No display", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  real1 [label="Real Live View\n(with DP2)", style=filled, color="#2e8b57", penwidth=3, fillcolor="#e6f7ee"];
  real2 [label="No display", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  real3 [label="Info display\nwith [i] menu", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];
  real4 [label="Info display\nwith [i] menu", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];
  real5 [label="Info display", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];
  real6 [label="Info display", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];
  real7 [label="No display", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  real8 [label="Info display", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];

  // Virtual LV model row
  virt0 [label="No display\nnDP=2", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  virt1 [label="Real Live View\n(with DP2)\nnDP=2", style=filled, color="#2e8b57", penwidth=3, fillcolor="#e6f7ee"];
  virt2 [label="No display\nnDP=2", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  virt3 [label="Info display\nwith [i] menu\nnDP=2", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];
  virt4 [label="Virtual LV (DP5)\nwith [i] menu\nnDP=5", style=filled, color="#ff8c00", penwidth=3, fillcolor="#f2f2f2"];
  virt5 [label="Virtual LV (DP5)\nnDP=5", style=filled, color="#ff8c00", penwidth=3, fillcolor="#f2f2f2"];
  virt6 [label="Info display\nnDP=5", style=filled, color="#000000", penwidth=3, fillcolor="#6e6e6e", fontcolor="#ffffff"];
  virt7 [label="No display\nnDP=5", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  virt8 [label="Virtual LV (DP5)\nnDP=5", style=filled, color="#ff8c00", penwidth=3, fillcolor="#f2f2f2"];

  // Controlled experiment row
  ctrl0 [label="No display\nnDP=2", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  ctrl1 [label="Real Live View\n(with DP2)\nnDP=2", style=filled, color="#2e8b57", penwidth=3, fillcolor="#e6f7ee"];
  ctrl2 [label="No display\nnDP=2", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  ctrl3 [label="No [i] operation", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  ctrl4 [label="Real Live View\n(with DP2)\nnDP=2", style=filled, color="#2e8b57", penwidth=3, fillcolor="#e6f7ee"];
  ctrl5 [label="Real Live View\n(with DP2)\nnDP=2", style=filled, color="#2e8b57", penwidth=3, fillcolor="#e6f7ee"];
  ctrl6 [label="No display\nnDP=2", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  ctrl7 [label="No display\nnDP=2", style=filled, color="#333333", penwidth=1, fillcolor="#ffffff"];
  ctrl8 [label="Real Live View\n(with DP2)\nnDP=2", style=filled, color="#2e8b57", penwidth=3, fillcolor="#e6f7ee"];

  // Align columns
  { rank=same; t0; real0; virt0; ctrl0; }
  { rank=same; t1; real1; virt1; ctrl1; }
  { rank=same; t2; real2; virt2; ctrl2; }
  { rank=same; t3; real3; virt3; ctrl3; }
  { rank=same; t4; real4; virt4; ctrl4; }
  { rank=same; t5; real5; virt5; ctrl5; }
  { rank=same; t6; real6; virt6; ctrl6; }
  { rank=same; t7; real7; virt7; ctrl7; }
  { rank=same; t8; real8; virt8; ctrl8; }

  // Invisible edges to enforce left-to-right time order
  t0 -> t1 [style=invis];
  t1 -> t2 [style=invis];
  t2 -> t3 [style=invis];
  t3 -> t4 [style=invis];
  t4 -> t5 [style=invis];
  t5 -> t6 [style=invis];
  t6 -> t7 [style=invis];
  t7 -> t8 [style=invis];

  // Transitions (visible edges)
  real0 -> real1 [label="open", color="#2e8b57"];
  real1 -> real2 [label="close", color="#2e8b57"];
  real2 -> real3 [label="press [i]", color="#000000"];
  real3 -> real4 [label="open", color="#000000"];
  real4 -> real5 [label="half-press", color="#000000"];
  real5 -> real6 [label="close", color="#000000"];
  real6 -> real7 [label="power off/on", color="#333333"];
  real7 -> real8 [label="open", color="#333333"];

  virt0 -> virt1 [label="open", color="#2e8b57"];
  virt1 -> virt2 [label="close", color="#2e8b57"];
  virt2 -> virt3 [label="press [i]", color="#000000"];
  virt3 -> virt4 [label="open", color="#ff8c00"];
  virt4 -> virt5 [label="half-press", color="#ff8c00"];
  virt5 -> virt6 [label="close", color="#ff8c00"];
  virt6 -> virt7 [label="power off/on", color="#333333"];
  virt7 -> virt8 [label="open", color="#ff8c00"];

  ctrl0 -> ctrl1 [label="open", color="#2e8b57"];
  ctrl1 -> ctrl2 [label="close", color="#2e8b57"];
  ctrl2 -> ctrl3 [label="press [i]", color="#333333"];
  ctrl3 -> ctrl4 [label="open", color="#2e8b57"];
  ctrl4 -> ctrl5 [label="half-press", color="#2e8b57"];
  ctrl5 -> ctrl6 [label="close", color="#2e8b57"];
  ctrl6 -> ctrl7 [label="power off/on", color="#333333"];
  ctrl7 -> ctrl8 [label="open", color="#2e8b57"];

  // Keep rows aligned
  real0 -> virt0 [style=invis];
  virt0 -> ctrl0 [style=invis];
}
